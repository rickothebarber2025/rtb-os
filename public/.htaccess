<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.rtbheadquaters\.com$ [NC]
  RewriteRule ^ https://rtbheadquaters.com%{REQUEST_URI} [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # Never rewrite missing compiled assets to index.html. Returning HTML for a
  # JavaScript chunk causes the browser error: 'text/html' is not a valid
  # JavaScript MIME type. A real 404 lets the app's recovery path reload the
  # current deployment instead of hard-crashing on a stale chunk reference.
  RewriteRule ^assets/ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
