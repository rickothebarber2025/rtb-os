{% endfor %}
@click.pass_context
def {{cmd.name | ToLowerSnakeCase}}(ctx: click.Context, device_id: Optional[str],
  {{input_struct.fields | ToFieldArgs }}) -> bool:
  """Sends {{cmd.name | ToLowerSnakeCase}} command to the given device.

  Returns:
    True on success, False on failure.
  """
  if ctx.resilient_parsing:
    # Allow click automatic handling of --help
    return True
  print('Action: {{cmd.name | ToLowerSnakeCase}}')
  api = ctx.obj['home']
  device = api.get_device(device_id)
  if not device:
    print('Device not found')
    return False
  trait = device.get_trait({{cluster.name | ToLowerSnakeCase}}_trait.{{cluster.name}})
  if not trait:
    print('Device does not have {{cluster.name | ToLowerSnakeCase}} trait')
    return False
  {%- for field_name in input_struct.fields | map(attribute="name") | map("ToLowerSnakeCase") %}
  print('{{field_name}}: ', {{field_name}})
  {%- endfor %}

  response = trait.{{cmd.name | ToLowerSnakeCase}}(
