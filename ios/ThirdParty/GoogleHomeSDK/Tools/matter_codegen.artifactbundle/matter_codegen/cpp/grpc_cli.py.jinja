{% endfor %}


def do_trait(line: str, api: home.Home) -> bool:
  """Runs the trait command for the {{cluster.name | ToLowerSnakeCase}} trait.

  Returns:
    True on success, False on failure.
  """
  args = shlex.split(line, posix=False)
  if len(args) < 2 or args[1] in ['', '--help', '-h', '-?']:
    print(f"""
    Usage:
       trait {{cluster.name | ToLowerSnakeCase}} <action> [args]
    Where:
       action = {" | ".join(_COMMANDS)}
    """)
    return True
  action = args[1]
  if action not in _COMMANDS:
    print('Action unknown to {{cluster.name}}Trait: %s' % action)
    return False
  try:
    # Parse arguments directly within the context
    with trait_cmd.make_context('trait', args) as ctx:
      ctx.obj = {'home': api}
      return trait_cmd.invoke(ctx)
  except click.exceptions.UsageError as e:
    print('UsageError: %s' % e)
  except click.exceptions.Exit:
    pass
  return False
