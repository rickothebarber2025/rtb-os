                            const {{cluster.name}}::Command::{{cmd.name}}::Request* grpc_request,
                            {{cluster.name}}::Command::{{cmd.name}}::Response* grpc_response) override {
    LOG(INFO) << "{{cluster.name}}Service::Command{{cmd.name}}";

    Trait* trait = GetRequestObject(grpc_request);
    if (!trait) {
      return ::grpc::Status(::grpc::StatusCode::NOT_FOUND, "Trait not found");
    }

    {# TODO: b/353278923 - more error handling #}
    grpc_response->set_value(false);
    absl::Notification notification;

    {%-  for field in input_struct.fields %}
       {{field | ToCommandParameter(cluster.name, typeLookup)}};
    {%- endfor %}
    {%-  for field in input_struct.fields %}
       {{field | ToGrpcFieldInitializer(typeLookup)}}
    {%- endfor %}
    trait->{{cmd | ToCommandName(cluster)}}(
      {%- for field in input_struct.fields %}
      {{field.name | ToLowerSnakeCase}},
      {%- endfor %}
      [&notification, grpc_response](auto value) {
      if (!notification.HasBeenNotified()) {
        grpc_response->set_value(true);
        notification.Notify();
      }
    });

    notification.WaitForNotification();

    return ::grpc::Status::OK;
  }
  {%- endfor %}

 private:
  template <typename RequestT>
  Trait* GetRequestObject(const RequestT* grpc_request) {
    Trait* trait = reinterpret_cast<Trait*>(grpc_request->object_handle());
    if (!context_.HasObject(trait)) {
      return nullptr;
    }
    return trait;
  }

