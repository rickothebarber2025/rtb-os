      {%- for attr in cluster.attributes %}
      {{attr | ToGrpcServiceAttributeSet(cluster)}}
      {%- endfor %}
    });
{% endif %}
    return ::grpc::Status::OK;
  }
{%   for cmd in cluster.commands -%}
