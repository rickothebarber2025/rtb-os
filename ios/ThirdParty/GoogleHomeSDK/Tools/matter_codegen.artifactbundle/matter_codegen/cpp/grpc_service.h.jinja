class {{cluster.name}}Service final : public grpc::{{cluster.name}}Service::Service {
 public:
  using Trait = ::google_home_api::traits::{{PACKAGE_NAMESPACE}}::{{cluster.name}};

  {# TODO: go/totw/116 - Ok to reference because ApiContext is never temporary. #}
  explicit {{cluster.name}}Service(ApiContext& context) : context_(context) {
    context_.SetDeleteObjectFunction(Trait::kTraitId, [](void* object) -> void {
      delete reinterpret_cast<Trait*>(object);
    });
    context_.SetDeviceGetTraitFunction(
        Trait::kTraitId, [](Device& device) -> void* {
          Trait* trait = nullptr;
          device.GetTrait<Trait>().Collect([&trait](auto collected_trait) {
            trait = new Trait(std::move(collected_trait));
          });
          return trait;
        });
    context_.SetDeviceHasTraitFunction(
        Trait::kTraitId,
        [](const Device& device) -> bool { return device.HasTrait<Trait>(); });
  }

  ::grpc::Status AttributeGet(
      ::grpc::ServerContext* server_context,
      const {{cluster.name}}::Attribute::Get::Request* grpc_request,
      {{cluster.name}}::Attribute::Get::Response* grpc_response) override {
    LOG(INFO) << "{{cluster.name}}Service::AttributeGet";

    Trait* trait = GetRequestObject(grpc_request);
    if (!trait) {
      return ::grpc::Status(::grpc::StatusCode::NOT_FOUND, "Trait not found");
    }

    {{cluster.name}}Trait::Attributes attributes = trait->GetAttributes();

    {%- for attr in cluster.attributes %}
    {{attr | ToGrpcServiceAttributeGet(cluster)}}
    {%- endfor %}

    return ::grpc::Status::OK;
  }

  ::grpc::Status AttributeSet(
      ::grpc::ServerContext* server_context,
      const {{cluster.name}}::Attribute::Set::Request* grpc_request,
      {{cluster.name}}::Attribute::Set::Response* grpc_response) override {
