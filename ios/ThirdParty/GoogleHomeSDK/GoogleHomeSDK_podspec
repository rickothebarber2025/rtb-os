Pod::Spec.new do |s|
  s.name             = 'GoogleHomeSDK'
  s.version          = '1.10.1'
  s.summary          = 'Google Home SDK for iOS.'
  s.description      = 'The Google Home SDK for iOS allows you to build applications that interact with the Google Home ecosystem.'
  s.homepage         = 'https://developers.home.google.com/mobile-sdk'
  s.license          = { :type => 'Apache 2.0', :file => 'LICENSE' }
  s.author           = 'Google LLC'
  s.source           = { :git => 'https://github.com/google/google-home-ios-sdk.git', :tag => s.version.to_s }
  s.ios.deployment_target = '17.0'
  s.default_subspecs = ['SDK', 'Types']

  s.subspec 'SDK' do |sdk|
    sdk.vendored_frameworks = ['Frameworks/GoogleHomeSDK.xcframework']
    sdk.frameworks = ['Combine', 'CryptoKit', 'Foundation', 'Matter', 'UIKit']
    sdk.libraries = ['c++', 'sqlite3', 'z']
  end

  s.subspec 'Types' do |types|
    types.vendored_frameworks = ['Frameworks/GoogleHomeTypes.xcframework']
    types.dependency 'GoogleHomeSDK/SDK'
    types.frameworks = 'Foundation'
  end

  s.test_spec 'Tests' do |ss|
    ss.source_files = 'Tests/**/*.swift'
    ss.dependency 'GoogleHomeSDK/SDK'
    ss.dependency 'GoogleHomeSDK/Types'
  end

end
