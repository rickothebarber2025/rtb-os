+
+/* ============================================================
+   Dashboard in-page mobile tabs
+   Requested fix: the dashboard stacked 13+ sections vertically
+   on mobile, requiring a lot of scrolling/swiping to reach
+   payroll, leaderboard, and appointment data. On narrow screens
+   only, group those sections behind a small tab bar so one
+   section shows at a time. Desktop is completely unaffected --
+   every section still renders, unchanged, all at once.
+   ============================================================ */
+.dashboard-mobile-tabs {
+  display: none;
+}
+
+@media (max-width: 900px) {
+  .dashboard-mobile-tabs {
+    display: flex;
+    gap: 0.4rem;
+    overflow-x: auto;
+    padding: 0.2rem 0.1rem 0.6rem;
+    scrollbar-width: none;
+    -ms-overflow-style: none;
+  }
+
+  .dashboard-mobile-tabs::-webkit-scrollbar {
+    display: none;
+  }
+
+  .dashboard-mobile-tabs__item {
+    background: transparent;
+    border: 1px solid rgba(255, 255, 255, 0.14);
+    border-radius: 999px;
+    color: var(--muted);
+    cursor: pointer;
+    flex: 0 0 auto;
+    font-size: 0.78rem;
+    font-weight: 700;
+    padding: 0.5rem 0.95rem;
+    white-space: nowrap;
+  }
+
+  .dashboard-mobile-tabs__item.active {
+    background: var(--gold-soft);
+    border-color: rgba(255, 255, 255, 0.32);
+    color: var(--gold-strong);
+    box-shadow: inset 0 -2px 0 0 var(--shell-accent);
+  }
+
+  .dashboard-page [data-mobile-group]:not(.is-active-mobile-tab) {
+    display: none !important;
+  }
+}
